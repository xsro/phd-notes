  volume = {60},
  number = {5},
  pages = {5906--5919},
  issn = {0018-9251},
  doi = {10.1109/TAES.2024.3398600},
  urldate = {2026-05-29},
  abstract = {This article is concerned with the geometric tracking control of a free-flying space robot with predefined-time stability. To overcome the singularity and nonuniqueness issues in attitude representation, the kinematics, and dynamics of the space robot are formulated on \textbackslash textbackslashbm \textbraceleft SE(3)\textbraceright\textbackslash. By virtue of the geometric description and proper configuration error functions, the mathematical model for pose (translation and orientation) tracking errors is further established. Different from the existing results on space robot control, a geometric dynamic surface controller is designed for fulfilling the position and orientation tracking of the space robot living on \textbackslash textbackslashbm \textbraceleft SE(3)\textbraceright\textbackslash{} within a predefined time. Furthermore, the predefined-time stability of the controlled system is rigorously proven according to Lyapunov stability theory. Finally, numerical studies are performed to verify the effectiveness and performance of the developed control algorithm.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  eissn = {1557-9603},
  langid = {english},
