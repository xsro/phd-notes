@article{chenPrescribedPerformanceObservercontroller2025,
  title = {Prescribed Performance Observer-Controller Design for {{MIMO}} Nonlinear Systems with Unknown Control Directions},
  author = {Chen, Guan-Qun and Xie, Wen-Bo and Qu, Dong and Peng, Yan},
  year = {2025},
  month = {jun},
  journal = {ISA Transactions},
  volume = {161},
  pages = {136--144},
  issn = {0019-0578},
  doi = {10.1016/j.isatra.2025.03.021},
  urldate = {2026-06-20},
  abstract = {In this paper, an observer-controller with performance constraints is proposed for a class of multi-input multi-output (MIMO) nonlinear systems with unknown input directions. First, a novel method for limiting estimation error is proposed in the observer design process, which is achieved by integrating the equivalent output injection approach with the prescribed performance technique. Subsequently, a controller is presented that combines the Nussbaum function with the prescribed performance control (PPC) method, which can address the issue of unknown control directions and ensure constrained tracking errors. Finally, the effectiveness of the proposed methodology is validated via a trajectory tracking control task for an unmanned surface vehicle (USV).},
  langid = {english},
  keywords = {Estimation error constraint,MIMO nonlinear systems,Nussbaum function,Prescribed performance,Unmanned surface vehicle},
  file = {C\:\\Users\\jinze\\Zotero\\storage\\8DY9NPR5\\Chen 等 - 2025 - Prescribed performance observer-controller design for MIMO nonlinear systems with unknown control di.pdf;C\:\\Users\\jinze\\Zotero\\storage\\6NNDFANH\\S0019057825001594.html},
}

@article{dingStrongPrescribedtimeStabilization2024,
  title = {Strong Prescribed-Time Stabilization of Uncertain Nonlinear Systems by Periodic Delayed Feedback},
  author = {Ding, Yi and Zhou, Bin and Zhang, Kang-Kang and Michiels, Wim},
  year = {2024},
  month = {jun},
  journal = {IEEE Transactions on Automatic Control},
  volume = {69},
  number = {6},
  pages = {4072--4079},
  issn = {1558-2523},
  doi = {10.1109/TAC.2023.3347703},
  urldate = {2026-05-22},
  abstract = {In this article, a novel Lyapunov-based approach for strong prescribed-time stabilization by periodic delayed feedback is established. Since the comparison lemma cannot be directly applied to time-delay systems, their proofs rely on trajectory analysis. Based on this approach, a novel control law for strong prescribed-time stabilization of uncertain scalar nonlinear systems is obtained, with the following appealing properties: singularity problems inherent to time-varying high gain approaches are avoided; strong prescribed-time stabilization is achieved with control terms exhibiting a linear growth rate in the combined current and delayed state variable; the achieved fixed-time stability is preserved under classes of additive perturbations; and the setting time of the closed-loop system equals the prescribed value for some admissible uncertainties. Subsequently, using the backstepping procedure, a strongly prescribed-time stabilizing control law for strict feedback uncertain nonlinear systems is designed. Numerical simulations are shown to verify the effectiveness of the proposed approaches.},
  langid = {english},
  keywords = {Asymptotic stability,Delay effects,High-order nonlinear systems,Lyapunov methods,Nonlinear systems,Numerical stability,periodic delayed feedback (PDF),prescribed-time stabilization,Stability criteria,strong prescribed-time stabilization,Uncertainty},
  file = {C:\Users\jinze\Zotero\storage\79P2FU3H\Ding 等 - 2024 - Strong prescribed-time stabilization of uncertain nonlinear systems by periodic delayed feedback.pdf},
}

@article{huConstrainedFixedTimeTerminal2024,
  title = {Constrained Fixed-Time Terminal Sliding-Mode Control with Prescribed Performance for Space Manipulator System},
  author = {Hu, Meiling and Yang, Xuebo and Dong, Hanlin},
  year = {2024},
  month = {feb},
  journal = {IEEE Transactions on Aerospace and Electronic Systems},
  volume = {60},
  number = {1},
  pages = {1074--1090},
  issn = {0018-9251},
  doi = {10.1109/TAES.2023.3333809},
  abstract = {This article focuses on the high-precision position tracking problem for the free-float space manipulator (FFSM) system subject to parametric uncertainties, input saturation, and state constraints. To this end, the screw-based dynamics using the Newton-Euler iterative method, with a global and unique attitude representation, are established; then, a chattering-free fixed-time sliding-mode control (FTSMC) scheme is developed based on the proposed dynamics model. A radial basis function neural network (RBFNN) with proper hidden layers and nodes is integrated into the proposed controller, while modeling approximation errors are well-inhibited by adaptive laws. Since the tracking error has been explicitly constrained by an exponential decay function, the Lyapunov analysis indicates that the transient and steady performance and state constraints can be guaranteed simultaneously. Simulation experiments taking an FFSM with six-degree-of-freedom (DOF) illustrate the effectiveness of the proposed control scheme from two aspects: joint-space positioning and trajectory tracking.},
  eissn = {1557-9603},
  langid = {english},
  numbers = {Dong, Hanlin/PUF-2414-2026 Yang, Xuebo/P-3943-2017},
  id = {WOS:001173889500008},
  file = {C:\Users\jinze\Zotero\storage\J22RYQF6\Hu 等 - 2024 - Constrained fixed-time terminal sliding-mode control with prescribed performance for space manipulat.pdf},
}

@article{katsoukisLowComplexityRobust2022,
  title = {A Low Complexity Robust Output Synchronization Protocol with Prescribed Performance for High-Order Heterogeneous Uncertain {{MIMO}} Nonlinear Multiagent Systems},
  author = {Katsoukis, Ilias and Rovithakis, George A.},
  year = {2022},
  month = {jun},
  journal = {IEEE Transactions on Automatic Control},
  volume = {67},
  number = {6},
  pages = {3128--3133},
  issn = {0018-9286, 1558-2523, 2334-3303},
  doi = {10.1109/TAC.2021.3096803},
  urldate = {2024-07-01},
  abstract = {We consider the problem of synchronizing, with prescribed transient and steady-state performance guarantees, the output of high-order, nonlinear, multiagent systems in a leader--following scenario. The agent dynamics are MIMO in lower triangular form and uncertain, as all nonlinearities are unknown and moreover they are perturbed by external additive disturbances. Furthermore, no knowledge is provided regarding bounds or functions bounding the actual system nonlinearities. In addition, the dynamic orders of all agents may not be the same. Each agent utilizes only relative output information from its neighbors and its own state. The underlying communication graph is directed. The proposed control protocol is distributed and of low analytic and computational complexity; thus facilitating implementation. Simulation studies clarify the approach and highlight the theoretical findings.},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  langid = {english},
